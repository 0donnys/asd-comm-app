<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Основная тема: без панели действий, светлый фон, портретная ориентация -->
    <style name="Theme.KommunikativnyeIgry" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Тема-заставка: показывается, пока грузится WebView -->
    <style name="Theme.KommunikativnyeIgry.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
